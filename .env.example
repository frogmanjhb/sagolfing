# Public site URL (used for SEO / sitemap)
VITE_SITE_URL=https://www.sagolfing.com

# Web3Forms access key — form submissions are emailed to the address you configure at https://web3forms.com
# Create a free account, add info@sagolfing.com as the notification email, then paste your access key here.
# Set the same variable in Railway (or your host) for production.
VITE_WEB3FORMS_ACCESS_KEY=
